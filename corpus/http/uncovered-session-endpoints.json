{
  "endpoint": "POST /session/ticket and POST /session/rebind",
  "port": 2121,
  "spec_status": "spec-uncovered — served by the reference implementation (origin/main @ 27baf22); no protocol-repo document or open docs PR covers them. Recorded here so the surface is visible and testable; promoting them to spec (or removing them) is a protocol-repo decision per AGENTS.md (no spec edits to match one implementation without cross-implementation agreement).",
  "identity": "device identifier resolved from the request's network context (no report headers on these routes)",
  "vectors": [
    {
      "id": "session-ticket/issue-happy-path",
      "request": {
        "method": "POST",
        "path": "/session/ticket"
      },
      "preconditions": {
        "session": "active for the requesting device"
      },
      "response": {
        "status": 200,
        "content_type": "application/json",
        "body": {
          "type": "json",
          "fields": {
            "status": 1,
            "ticket": {
              "matcher": "nonempty"
            },
            "expires_at": {
              "matcher": "integer"
            }
          }
        }
      },
      "evidence": [
        {
          "kind": "source",
          "repo": "OpenTollGate/tollgate-module-basic-go",
          "ref": "origin/main @ 27baf22",
          "location": "src/main.go HandleSessionTicket 1372-1412; src/merchant/session_ticket.go (12h TTL)"
        }
      ],
      "notes": "A session ticket lets a device re-attach its session after its MAC changes (e.g. NIC swap) without re-paying. expires_at is unix seconds, session start + 12h."
    },
    {
      "id": "session-ticket/no-session",
      "request": {
        "method": "POST",
        "path": "/session/ticket"
      },
      "preconditions": {
        "session": "none",
        "gateway_mode": "full-service (degraded mode answers ticket-unavailable/rebind-failed before session lookup — see session-ticket/degraded-or-starting)"
      },
      "response": {
        "status": 404,
        "content_type": "application/json",
        "body": {
          "type": "json",
          "fields": {
            "status": 0,
