{
  "endpoint": "POST / (and any unregistered path — the / mux pattern is a catch-all)",
  "port": 2121,
  "spec_refs": [
    "HTTP-01#POST /",
    "tollgate#25 (docs/http01-legacy-payment-envelope): legacy kind=21000 envelope deprecated, servers MAY accept, unauthenticated container",
    "tollgate#27 (docs/tip01-degraded-mode): service-unavailable refusal precedes token processing, token not consumed",
    "tollgate#26 (docs/tip01-session-p-tag): raw-token payments omit the p tag"
  ],
  "identity": "device identifier (MAC) resolved from the request's network context (socket IP -> dhcp.leases -> /proc/net/arp); a ?mac= query claim is ignored and reported via X-TollGate-Mac-Claim-Ignored",
  "rate_limit": "per-IP limiter (default 10 req/min, burst 10) shared with GET /; see http01-discovery.json",
  "notes": "Reference-source wire facts (tollgate-module-basic-go origin/main @ 27baf22): body cap 1 MiB; allowed Content-Types: text/plain, application/json, absent (anything else: 415); errors after the media-type gate are answered as kind-21023 Notice event JSON with HTTP 400, not as a JSON error envelope; non-POST methods: 405 with empty body.",
